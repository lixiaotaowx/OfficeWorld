# LiveKit server endpoint.
# Plain HTTP pages must use ws:// (e.g. the local Vite dev server on http).
# Use wss:// once the page itself is served over HTTPS, otherwise the browser
# blocks the connection as mixed content.
LIVEKIT_URL=ws://your-livekit-host:7880

# API key and secret from the LiveKit server config: the "keys:" section of
# /etc/livekit/livekit.yaml. Never commit the real values.
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
