{
  "name": "office-world-desktop",
  "version": "0.1.16",
  "description": "iruler dream · 一起在场",
  "author": "iruler dream",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "icons": "powershell -ExecutionPolicy Bypass -File tools/build-icons.ps1",
    "dist": "electron-builder --win portable --x64",
    "dist:installer": "electron-builder --win nsis --x64",
    "dist:all": "electron-builder --win --x64",
    "publish:update": "node tools/publish-update.mjs"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.officeworld.desktop",
    "productName": "iruler dream",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "../Build/OfficeDesktopRelease"
    },
    "files": [
      "*.cjs",
      "package.json",
      "assets/icon.ico",
      "chrome.html",
      "chrome.css",
      "desktop-theme.css",
      "annotation-overlay.html",
      "annotation-overlay.css",
      "annotation-overlay.js",
      "preview-capture.html"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "iruler-dream-${version}-Windows-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "iruler dream",
      "uninstallDisplayName": "iruler dream",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "assets/installerSidebar.bmp",
      "installerHeader": "assets/installerHeader.bmp",
      "artifactName": "iruler-dream-Setup-${version}-x64.exe"
    }
  }
}
