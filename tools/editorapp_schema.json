ype": "number"}}, "required": ["x", "y", "z"]}, "distanceCm": {"type": "number", "description": "\u4ece\u6444\u50cf\u673a\u5230Actor\u539f\u70b9\u7684\u8ddd\u79bb\uff08\u5398\u7c73\uff09\u3002"}}, "required": ["name", "label", "class", "screenPosition", "worldLocation", "distanceCm"]}, "description": "\u56fe\u50cf\u4e2d\u6bcf\u4e2a\u88ab\u6807\u8bb0\u7684\u89d2\u8272\u5bf9\u5e94\u4e00\u4e2a\u6761\u76ee\u3002"}}, "required": ["image", "cameraLocation", "cameraRotation", "cameraFOV", "grid", "labeledActors"]}}, "required": ["returnValue"]}}, {"description": "\u6355\u83b7\u6574\u4e2a\u7f16\u8f91\u5668\u5e94\u7528\u7a0b\u5e8f\u7684\u7528\u6237\u53ef\u89c1\u56fe\u50cf\u3002", "name": "EditorToolset.EditorAppToolset.CaptureEditorImage", "inputSchema": {"type": "object"}, "outputSchema": {"type": "object", "properties": {"returnValue": {"title": "ToolsetImage", "description": "\u7f16\u8f91\u5668\u7a97\u53e3\u5728\u7528\u6237\u684c\u9762\u4e0a\u663e\u793a\u65f6\u7684\u56fe\u50cf\u3002", "type": "object", "properties": {"mimeType": {"type": "string", "description": "\u56fe\u50cf\u7684\u7f16\u7801\u683c\u5f0f\u3002"}, "data": {"type": "string", "description": "\u7f16\u7801\u4e3abase64\u5b57\u7b26\u4e32\u7684\u56fe\u50cf\u6570\u636e\u3002"}}, "required": ["mimeType", "data"]}}, "required": ["returnValue"]}}, {"description": "\u4e3a\u6307\u5b9a\u8d44\u4ea7\u6e32\u67d3\u7f29\u7565\u56fe\uff08\u4f8b\u5982\u9759\u6001\u7f51\u683c\u4f53\u3001\u9aa8\u9abc\u7f51\u683c\u4f53\u3001\n\u9aa8\u67b6\u3001\u52a8\u753b\u3001\u8499\u592a\u5947\u3001\u6750\u8d28\u3001\u7eb9\u7406\uff09\u3002", "name": "EditorToolset.EditorAppToolset.CaptureAssetImage", "inputSchema": {"type": "object", "properties": {"assetPath": {"type": "string", "description": "\u8d44\u4ea7\u7684\u8def\u5f84\uff0c\u4f8b\u5982'/Game/Meshes/SM_Cube'\u3002"}}, "required": ["assetPath"]}, "outputSchema": {"type": "object", "properties": {"returnValue": {"title": "ToolsetImage", "description": "\u8d44\u4ea7\u7684\u56fe\u50cf\u30